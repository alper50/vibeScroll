<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>vibeScroll</string>
    <key>CFBundleDisplayName</key>
    <string>vibeScroll</string>
    <key>CFBundleIdentifier</key>
    <string>dev.vibescroll.app</string>
    <key>CFBundleExecutable</key>
    <string>vibescroll</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <!-- Interface languages. Must match the .lproj folders build-app.sh
         compiles and ContentLanguage in the core: macOS only offers an app a
         language it declares here, and the card text follows the same list. -->
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>tr</string>
    </array>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>0.1.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <!-- Menu bar only: no Dock icon, no window on launch. -->
    <key>LSUIElement</key>
    <true/>
    <!-- The hosted catalogue is https. This only keeps a local backend
         (http://127.0.0.1:8787) reachable for development. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>
