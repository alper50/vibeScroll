    "Cards appear while an agent works, paced by what it is doing. They never take focus, and stay until you dismiss them.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartlar bir ajan çalışırken görünür; sıklığını ajanın yaptığı iş belirler. Asla odağı çalmaz ve sen kapatana kadar kalır."
          }
        }
      }
    },
