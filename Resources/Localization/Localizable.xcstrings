    "Agent events are queued to disk while vibeScroll is closed, so none are lost — but none are shown either.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "vibeScroll kapalıyken ajan olayları diske kuyruklanır; hiçbiri kaybolmaz ama hiçbiri gösterilmez de."
          }
        }
      }
    },
    "All %lld stopped": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ajanın hepsi durdu"
          }
        }
      }
    },
    "An hour without an agent.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir saattir ajan yok."
          }
        }
      }
    },
    "Appended to every queued prompt. A queued agent has nobody to answer it, so a question ends the run having done nothing.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuyruktaki her prompt'un sonuna eklenir. Kuyruktaki bir ajana yanıt verecek kimse yoktur; soru sorarsa hiçbir şey yapmadan çalışma biter."
          }
        }
      }
    },
