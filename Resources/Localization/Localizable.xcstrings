    "A menu bar app you have to remember to open is off exactly when it is needed.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açmayı hatırlaman gereken bir menü çubuğu uygulaması, tam ihtiyaç duyulduğunda kapalıdır."
          }
        }
      }
    },
    "A task is running": {
      "localizations": {
        "tr": {
          "stringUnit": {
